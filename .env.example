# Copy to .env.local and fill in. Never commit real values.
# Leave everything empty to run with the demo catalog (src/data/tracks.json).
# See docs/architecture/integration-design.md §7 for what each one does.

# --- Sanity (site) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# --- Temporary: set to true in Vercel Production to go live with the demo beats
# before Sanity is set up. Remove it once Sanity is configured. ---
ALLOW_DEMO_CONTENT=

# --- Audio ---
NEXT_PUBLIC_AUDIO_BASE_URL=

# --- Local only: used by `npm run upload-beat`, never set these in Vercel (Phase 1) ---
SANITY_API_WRITE_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=beats-public
